# Render using deploy/enable-https.sh after certificate issuance.
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=forms:10m rate=30r/m;
upstream django { server web:8000; }
server {
    listen 80 default_server;
    server_name DOMAIN_NAME;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://DOMAIN_NAME$request_uri; }
}
server {
    listen 443 ssl;
    http2 on;
    server_name DOMAIN_NAME;
    ssl_certificate /etc/letsencrypt/live/DOMAIN_NAME/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/DOMAIN_NAME/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 6M;
    limit_req_status 429;
    add_header X-Content-Type-Options nosniff always;
    location /static/ {
        alias /app/staticfiles/;
        expires 30d;
        add_header Cache-Control "public";
    }
    # Private file paths never bypass Django authorization, including old URLs.
    location ~ ^/media/(invoices|payment_slips)/ {
        proxy_pass http://django;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location /media/ {
        alias /app/media/;
        add_header X-Content-Type-Options nosniff always;
        expires 1h;
    }
    location ~ ^/(accounts/(login|register|password-reset)|admin/login) {
        limit_req zone=auth burst=5 nodelay;
        proxy_pass http://django;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location ~ ^/(wholesale|contact)/ {
        limit_req zone=forms burst=10 nodelay;
        proxy_pass http://django;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location / {
        proxy_pass http://django;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
