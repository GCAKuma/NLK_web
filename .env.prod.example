# Copy to .env.prod on the server; keep credentials out of Git.
DJANGO_SETTINGS_MODULE=config.settings.prod
DEBUG=False
# Generate a fresh value with Python secrets.token_urlsafe(64).
SECRET_KEY=CHANGE-ME
# Include localhost/127.0.0.1 for container health checks, plus your exact domain.
ALLOWED_HOSTS=example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://example.com
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# Runtime role created with secure_application_tables; URL-encode the password.
DATABASE_URL=postgresql://nlk_app.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
RUNTIME_DATABASE_ROLE=nlk_app
DB_CONN_MAX_AGE=60
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=email-smtp.YOUR_REGION.amazonaws.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=NLK <orders@example.com>
ADMIN_EMAIL=owner@example.com
WHATSAPP_PROVIDER=console
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# S3 credentials come from the EC2 instance IAM role, not access keys.
USE_S3=True
AWS_STORAGE_BUCKET_NAME=YOUR-PRIVATE-MEDIA-BUCKET
AWS_BACKUP_BUCKET_NAME=YOUR-PRIVATE-BACKUP-BUCKET
AWS_S3_REGION_NAME=YOUR_REGION
AWS_S3_ENDPOINT_URL=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# pg_dump client major must be >= the hosted PostgreSQL major.
PG_CLIENT_IMAGE=postgres:17
RELEASE_TAG=local
