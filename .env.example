# ---- Django ----
DJANGO_SETTINGS_MODULE=config.settings.dev
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ---- Database (Postgres) ----
POSTGRES_DB=nlk
POSTGRES_USER=nlk
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://nlk:change-me@db:5432/nlk

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---- Email (console in dev; swap to SMTP/SendGrid in prod) ----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=NLK <no-reply@nugasewana.lk>
ADMIN_EMAIL=admin@nugasewana.lk

# ---- WhatsApp admin alerts (pluggable) ----
# console = log only (default); meta = WhatsApp Cloud API (needs the two below)
WHATSAPP_PROVIDER=console
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
